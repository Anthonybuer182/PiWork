{
  "name": "com.pi.files",
  "version": "0.5.0",
  "private": true,
  "description": "文件查看器插件 — 右栏查看 docx/pptx/xlsx/pdf、markdown、html 和纯文本，并提供文档检索、新建、编辑、PDF 页操作与 PDF→Office 转换工具；文档由 vendor 的 GenOffice 引擎渲染（Apache-2.0）",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-backend.mjs && node scripts/build-panel.mjs",
    "build:backend": "node scripts/build-backend.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:backend": "node scripts/smoke-backend.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "vendor": "node scripts/vendor-genoffice.mjs",
    "vendor:check": "node scripts/vendor-genoffice.mjs --check",
    "vendor:verify": "node scripts/vendor-genoffice.mjs --verify",
    "build:panel": "node scripts/build-panel.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
